# ---------------------------------------------------------------------------
# VerdictPay environment. Copy to .env (root) or backend/.env.
# The entire demo runs with these defaults: no PayPal keys required.
# ---------------------------------------------------------------------------

APP_ENV=local
DEMO_MODE=true

# Database — SQLite by default, any async SQLAlchemy URL works (postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./verdictpay.db

# PayPal gateway: "simulator" (default, deterministic, no keys) or "live"
PAYPAL_MODE=simulator
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Shared secrets (DEV DEFAULTS — rotate for any real deployment)
VERDICTPAY_WEBHOOK_SECRET=dev-webhook-secret-change-me
VERDICTPAY_API_KEY=vp_demo_sk_local
VERDICTPAY_SIGNING_SECRET=dev-signing-secret-change-me

# Local dev only: accept unsigned webhooks. Never enable in production.
ALLOW_UNSIGNED_WEBHOOKS=false

# Narrative layer: "template" (deterministic, default) or "openai"
# "openai" means any OpenAI-compatible chat endpoint — hosted or local.
LLM_MODE=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Free local AI (no key, no data leaves the machine): install Ollama, then
#   ollama pull llama3.2
# and set LLM_MODE=openai with these two values:
LLM_BASE_URL=
LLM_MODEL=

# Optional sponsor adapters
ELASTIC_URL=
ELASTIC_API_KEY=
SUPABASE_URL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
