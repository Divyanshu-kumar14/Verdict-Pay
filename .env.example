# ---------------------------------------------------------------------------
# VerdictPay environment template.
#
#   cp .env.example .env      (then edit; .env is gitignored)
#
# Nothing here is required to run the demo: with PAYPAL_MODE=LOCAL_SIMULATOR
# and LLM_MODE=template the whole product runs offline with zero credentials.
# Every value below is a placeholder — never commit a real secret.
# ---------------------------------------------------------------------------

# local | test | production. In production the app refuses to boot with the
# development defaults in this file (dev signing secrets, unsigned webhooks).
APP_ENV=local
DEMO_MODE=true

# Origins the browser may call this API from. `make design-gate` serves the
# production build on http://127.0.0.1:3000 and refuses to inspect from any
# origin missing here (it would only measure blocked-request error states).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite by default; any async SQLAlchemy URL works.
# Postgres example: postgresql+asyncpg://user:pass@localhost:5432/verdictpay
DATABASE_URL=sqlite+aiosqlite:///./verdictpay.db

# --- PayPal gateway -------------------------------------------------------
# Three modes, resolved by backend/app/config.py (GatewayMode):
#
#   LOCAL_SIMULATOR  deterministic, keyless. No network, no PayPal account.
#                    Order ids, subscription ids, captures and disputes are
#                    derived from SHA-256 of the input, so runs are repeatable.
#   PAYPAL_SANDBOX   real calls to https://api-m.sandbox.paypal.com through the
#                    same adapter production uses. Needs BOTH credentials.
#                    Buyer approval is a human clicking the approval URL.
#   PAYPAL_LIVE      real calls to https://api-m.paypal.com — MOVES REAL MONEY.
#                    Also requires ALLOW_PAYPAL_LIVE=true.
#
# A network mode with missing credentials raises at startup instead of
# silently falling back to the simulator: a judge must never believe they are
# watching a real PayPal call when they are not.
PAYPAL_MODE=LOCAL_SIMULATOR

# Leave empty to use the mode's default host. Set explicitly to override:
#   sandbox -> https://api-m.sandbox.paypal.com
#   live    -> https://api-m.paypal.com
PAYPAL_API_BASE=

# Sandbox app credentials: developer.paypal.com -> Apps & Credentials -> Sandbox.
# Placeholders only. Never paste a real client id or secret into this file.
PAYPAL_CLIENT_ID=<your-paypal-sandbox-client-id>
PAYPAL_CLIENT_SECRET=<your-paypal-sandbox-client-secret>

# Needed only for webhook signature verification (POST /api/v1/webhooks/paypal).
# Without it, sandbox traffic is rejected unless ALLOW_UNSIGNED_WEBHOOKS=true.
PAYPAL_WEBHOOK_ID=

# Second safety latch for production money. PAYPAL_MODE=PAYPAL_LIVE refuses to
# start unless this is literally true (backend/app/config.py validator).
ALLOW_PAYPAL_LIVE=false

# Optional. Sent to PayPal as application_context.return_url / cancel_url so the
# buyer lands back on the app after approving or cancelling. Empty = PayPal's
# own confirmation page.
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# Per-request HTTP timeout for PayPal calls, in seconds.
PAYPAL_TIMEOUT_SECONDS=15

# --- shared secrets -------------------------------------------------------
# Generate real values with: openssl rand -hex 32
# The app refuses to boot in production while these dev values are in place.
VERDICTPAY_API_KEY=vp_demo_sk_local
VERDICTPAY_SIGNING_SECRET=dev-signing-secret-change-me
VERDICTPAY_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Only for local experiments: accept PayPal webhooks with no signature.
ALLOW_UNSIGNED_WEBHOOKS=false
# Reject telemetry batches that are not HMAC-signed. Keep true.
REQUIRE_SIGNED_TELEMETRY=true
# Replay window for the X-VerdictPay-Timestamp signature, in seconds.
WEBHOOK_TOLERANCE_SECONDS=300

# --- AI: Gemini layer (claim classification + evidence drafting) ----------
# Drives POST /api/v1/disputes/{id}/ai/analyze. With no key, or AI_ENABLED=false,
# the endpoint still returns a correct analysis built from the deterministic
# keyword classifier and the template narrative, with degraded=true.
GEMINI_API_KEY=<your-google-ai-studio-key>
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=true
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=1

# --- narrative provider (dossier prose) -----------------------------------
# template = deterministic offline prose (default, always available)
# openai   = any OpenAI-compatible endpoint; a local Ollama needs no key:
#            LLM_MODE=openai LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.2
# gemini   = draft the dossier narrative with Gemini as well
LLM_MODE=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MODEL=

# --- optional sponsor adapter ---------------------------------------------
# Elasticsearch mirror of telemetry. Off the demo path; SQL stays authoritative.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=verdictpay

# --- deterministic economics ----------------------------------------------
# These are the numbers the README quotes. Overriding them changes every EV.
STANDARD_FEE_USD=15.00
HIGH_VOLUME_FEE_USD=30.00
RATIO_THRESHOLD=0.015
OFFER_RATIO=0.30
HIGH_VOLUME_MIN_SALES=100

# --- server identity and limits -------------------------------------------
# Structural defaults; change only if you mount the API under another prefix
# or behind a proxy that uses a different correlation header.
APP_NAME=VerdictPay API
API_V1_PREFIX=/api/v1
REQUEST_ID_HEADER=X-Request-Id
ARTIFACTS_DIR=./artifacts
MAX_BODY_BYTES=262144
MAX_BATCH_EVENTS=500
RATE_LIMIT_PER_MINUTE=600
ACTION_LATENCY_BUDGET_MS=500
LOG_LEVEL=INFO

# --- demo identity --------------------------------------------------------
# Fixed so the seeded demo is reproducible. Changing these changes the
# deterministic order/subscription/capture ids derived from them.
DEMO_MERCHANT_NAME=Aurora Analytics
DEMO_PAYER_ID=YRZ829104KLA
DEMO_ORDER_ID=5O190127TN364715T
DEMO_SUBSCRIPTION_ID=I-BW452GLLEP1G

# --- frontend (frontend/.env.local, or exported before `pnpm dev`) --------
# Public by design (demo key); rotate for any real deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_VERDICTPAY_API_KEY=vp_demo_sk_local
