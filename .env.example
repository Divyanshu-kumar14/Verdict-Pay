# ---------------------------------------------------------------------------
# VerdictPay environment template.
# Copy to .env and fill in your own values. Never commit .env.
#
# The demo runs with zero credentials in simulator mode. Real PayPal sandbox
# calls need PAYPAL_MODE=live, PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET.
# ---------------------------------------------------------------------------
APP_ENV=local
DEMO_MODE=true

# SQLite by default; any async SQLAlchemy URL works (postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./verdictpay.db

# --- PayPal gateway -------------------------------------------------------
# simulator = deterministic, keyless demo path (default, tested)
# live      = real PayPal sandbox/production calls with the credentials below
PAYPAL_MODE=simulator
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Needed only when you register a webhook in the PayPal dashboard.
PAYPAL_WEBHOOK_ID=

# --- shared secrets -------------------------------------------------------
# Generate: openssl rand -hex 32
# The app refuses to boot in production with the dev defaults below.
VERDICTPAY_API_KEY=vp_demo_sk_local
VERDICTPAY_SIGNING_SECRET=dev-signing-secret-change-me
VERDICTPAY_WEBHOOK_SECRET=dev-webhook-secret-change-me
ALLOW_UNSIGNED_WEBHOOKS=false

# --- AI narrative ---------------------------------------------------------
# template = deterministic offline fallback (default)
# openai   = any OpenAI-compatible endpoint; local Ollama needs no key:
#            LLM_MODE=openai LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.2
LLM_MODE=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MODEL=

# --- optional sponsor adapters -------------------------------------------
ELASTIC_URL=
ELASTIC_API_KEY=

# --- frontend -------------------------------------------------------------
# Public by design (demo key); rotate for any real deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_VERDICTPAY_API_KEY=vp_demo_sk_local
# Origins the browser may call this API from. make design-gate serves the
# production build on http://127.0.0.1:3000 and refuses to inspect from any
# origin missing here (it would only measure the blocked-request error states).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
