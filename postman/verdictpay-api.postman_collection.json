    {
      "name": "Telemetry",
      "item": [
        {
          "name": "Telemetry batch",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build the body here so the signed bytes are exactly the bytes sent.",
                  "const payload = {",
                  "  events: [{",
                  "    event_id: \"postman-\" + Date.now(),",
                  "    event_type: \"USAGE_METERED\",",
                  "    paypal_payer_id: pm.environment.get(\"payerId\") || \"YRZ829104KLA\",",
                  "    paypal_order_id: pm.environment.get(\"orderId\") || \"5O190127TN364715T\",",
                  "    client_ip: \"203.0.113.42\",",
                  "    device_fingerprint: \"fp_89a7c6d5e4f3\",",
                  "    resource_id: \"postman_export.xlsx\",",
                  "    resource_sha256: \"9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08\",",
                  "    units_consumed: 1450,",
                  "    metadata: { source: \"postman\" }",
                  "  }]",
                  "};",
                  "const rawBody = JSON.stringify(payload);",
                  "pm.request.body.raw = rawBody;",
                  "const secret = pm.environment.get(\"signingSecret\");",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "let cryptoLib;",
                  "try {",
                  "  cryptoLib = (typeof CryptoJS !== \"undefined\") ? CryptoJS : require(\"crypto-js\");",
                  "} catch (error) {",
                  "  throw new Error(\"This request needs Postman's built-in crypto-js. Use Postman Desktop, or set REQUIRE_SIGNED_TELEMETRY=false on a local API only.\");",
                  "}",
                  "const signature = cryptoLib.HmacSHA256(timestamp + \".\" + rawBody, secret).toString();",
                  "pm.request.headers.upsert({ key: \"X-VerdictPay-Timestamp\", value: timestamp });",
                  "pm.request.headers.upsert({ key: \"X-VerdictPay-Signature\", value: signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"batch is appended to the hash chain\", function () {",
                  "  pm.expect(body.accepted).to.be.at.least(1);",
                  "  pm.expect(body.events[0].event_type).to.eql(\"USAGE_METERED\");",
                  "  pm.expect(body.events[0].prev_hash).to.have.length(64);",
                  "  pm.expect(body.events[0].chain_hash).to.have.length(64);",
                  "  pm.expect(body.chain.valid).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/telemetry/events",
            "description": "Direct ingest of a signed telemetry batch. The pre-request script builds the body, signs the exact bytes with HMAC-SHA256 over \"<unixSeconds>.<body>\" using {{signingSecret}}, and sends X-VerdictPay-Timestamp / X-VerdictPay-Signature. The API rejects unsigned ingest by default. @verdictpay/sdk does this automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"event_type\": \"USAGE_METERED\",\n      \"paypal_payer_id\": \"{{payerId}}\",\n      \"paypal_order_id\": \"{{orderId}}\",\n      \"client_ip\": \"203.0.113.42\",\n      \"device_fingerprint\": \"fp_89a7c6d5e4f3\",\n      \"resource_id\": \"postman_export.xlsx\",\n      \"resource_sha256\": \"9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08\",\n      \"units_consumed\": 1450,\n      \"metadata\": {\n        \"source\": \"postman\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
