    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Signed webhook example",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build the body here so the signed bytes are exactly the bytes sent.",
                  "const payload = {",
                  "  id: \"WH-POSTMAN-\" + Date.now(),",
                  "  event_type: \"CUSTOMER.DISPUTE.CREATED\",",
                  "  resource_type: \"dispute\",",
                  "  summary: \"A customer dispute has been created (Postman signed example).\",",
                  "  resource: {",
                  "    dispute_id: \"PP-D-99001\",",
                  "    reason: \"MERCHANDISE_OR_SERVICE_NOT_RECEIVED\",",
                  "    dispute_life_cycle_stage: \"INQUIRY\",",
                  "    dispute_channel: \"INTERNAL\",",
                  "    status: \"OPEN\",",
                  "    dispute_amount: { currency_code: \"USD\", value: \"99.00\" },",
                  "    payer: { payer_id: pm.environment.get(\"payerId\") || \"YRZ829104KLA\" },",
                  "    seller_transaction_id: pm.environment.get(\"orderId\") || \"5O190127TN364715T\",",
                  "    create_time: new Date().toISOString(),",
                  "    seller_response_due_date: new Date(Date.now() + 10 * 86400000).toISOString(),",
                  "    links: []",
                  "  }",
                  "};",
                  "const rawBody = JSON.stringify(payload);",
                  "pm.request.body.raw = rawBody;",
                  "const secret = pm.environment.get(\"webhookSecret\");",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "let cryptoLib;",
                  "try {",
                  "  cryptoLib = (typeof CryptoJS !== \"undefined\") ? CryptoJS : require(\"crypto-js\");",
                  "} catch (error) {",
                  "  throw new Error(\"This request needs Postman's built-in crypto-js. Use Postman Desktop, or set ALLOW_UNSIGNED_WEBHOOKS=true and delete the signature headers for a local-only test.\");",
                  "}",
                  "const signature = cryptoLib.HmacSHA256(timestamp + \".\" + rawBody, secret).toString();",
                  "pm.request.headers.upsert({ key: \"X-VerdictPay-Timestamp\", value: timestamp });",
                  "pm.request.headers.upsert({ key: \"X-VerdictPay-Signature\", value: signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"signed webhook is accepted and replay-safe\", function () {",
                  "  pm.expect(body.received).to.eql(true);",
                  "  pm.expect(body.event_id).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.dispute_id).to.eql(\"PP-D-99001\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/webhooks/paypal",
            "description": "Posts a PayPal-style CUSTOMER.DISPUTE.CREATED event signed with X-VerdictPay-Signature = hex(HMAC-SHA256(webhookSecret, '<unixSeconds>.<exactBody>')). The pre-request script builds the body and signs the exact bytes it sends.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"replaced-by-the-pre-request-script\",\n  \"event_type\": \"CUSTOMER.DISPUTE.CREATED\",\n  \"resource_type\": \"dispute\",\n  \"summary\": \"A customer dispute has been created (Postman signed example).\",\n  \"resource\": {\n    \"dispute_id\": \"PP-D-99001\",\n    \"reason\": \"MERCHANDISE_OR_SERVICE_NOT_RECEIVED\",\n    \"dispute_life_cycle_stage\": \"INQUIRY\",\n    \"dispute_channel\": \"INTERNAL\",\n    \"status\": \"OPEN\",\n    \"dispute_amount\": {\n      \"currency_code\": \"USD\",\n      \"value\": \"99.00\"\n    },\n    \"payer\": {\n      \"payer_id\": \"{{payerId}}\"\n    },\n    \"seller_transaction_id\": \"{{orderId}}\",\n    \"create_time\": \"2026-01-01T00:00:00.000Z\",\n    \"seller_response_due_date\": \"2026-01-11T00:00:00.000Z\",\n    \"links\": []\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
