{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisputeCase",
  "type": "object",
  "required": [
    "dispute_id",
    "payment_rail",
    "dispute_channel",
    "dispute_life_cycle_stage",
    "reason",
    "amount",
    "source_plane",
    "links"
  ],
  "properties": {
    "dispute_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$",
      "maxLength": 64
    },
    "payment_rail": {
      "type": "string",
      "enum": [
        "PAYPAL_WALLET",
        "UNBRANDED_CARD"
      ]
    },
    "dispute_channel": {
      "enum": [
        "INTERNAL",
        "EXTERNAL"
      ]
    },
    "dispute_life_cycle_stage": {
      "type": "string",
      "enum": [
        "INQUIRY",
        "CHARGEBACK",
        "PRE_ARBITRATION",
        "ARBITRATION",
        "RESOLVED",
        "CLOSED"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "MERCHANDISE_OR_SERVICE_NOT_RECEIVED",
        "MERCHANDISE_OR_SERVICE_NOT_AS_DESCRIBED",
        "UNAUTHORISED",
        "CREDIT_NOT_PROCESSED",
        "DUPLICATE_TRANSACTION",
        "INCORRECT_AMOUNT",
        "PAYMENT_BY_OTHER_MEANS",
        "CANCELED_RECURRING_BILLING",
        "PROBLEM_WITH_REMITTANCE",
        "OTHER"
      ]
    },
    "external_reason_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    },
    "amount": {
      "type": "object",
      "required": [
        "amount_minor",
        "amount_str",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "type": "integer"
        },
        "amount_str": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,3})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "seller_response_due_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sla_response_days": {
      "type": "integer",
      "enum": [
        3,
        10
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel",
          "href"
        ],
        "properties": {
          "rel": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        }
      }
    },
    "allowed_response_options": {
      "type": [
        "object",
        "null"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "posted_by": {
            "type": "string"
          },
          "time_posted": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "ce3_inputs": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "payment_credential_hash": {
          "type": "string"
        },
        "ip_hash": {
          "type": "string"
        },
        "device_id_hash": {
          "type": "string"
        },
        "account_login_id_hash": {
          "type": "string"
        },
        "shipping_address_hash": {
          "type": "string"
        }
      }
    },
    "source_plane": {
      "type": "string",
      "enum": [
        "LIVE_PAYPAL_SANDBOX",
        "SIMULATED_CARD_NETWORK_FEED",
        "INTERNAL_TEST_EVENT"
      ]
    }
  }
}
