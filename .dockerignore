# Build context hygiene: nothing here belongs in either image.

# VCS / editor
.git
.gitignore
.idea
.vscode
.DS_Store

# Python
**/__pycache__
**/*.py[cod]
**/.venv
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/htmlcov
**/.coverage
**/*.egg-info
backend/verdictpay.db
backend/verdictpay.db-wal
backend/verdictpay.db-shm

# Node
**/node_modules
**/.next
**/out
**/dist
**/.turbo
**/*.tsbuildinfo

# Secrets and local state
.env
.env.*
!.env.example
backend/artifacts
artifacts

# Not needed by either image
docs
postman
.github

# packages/verdictpay-sdk IS needed: the frontend depends on it through a file:
# path and the image builds it before installing the web app. Do not exclude it.
# (**/dist stays excluded — the SDK is compiled inside the image.)
