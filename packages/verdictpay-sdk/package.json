{
  "name": "@verdictpay/sdk",
  "version": "0.1.1",
  "description": "Pre-dispute telemetry SDK for PayPal-backed SaaS: batched, signed, hash-chain ready.",
  "license": "MIT",
  "author": "Divyanshu Kumar",
  "homepage": "https://github.com/Divyanshu-kumar14/Verdict-Pay/tree/main/packages/verdictpay-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Divyanshu-kumar14/Verdict-Pay.git",
    "directory": "packages/verdictpay-sdk"
  },
  "bugs": {
    "url": "https://github.com/Divyanshu-kumar14/Verdict-Pay/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "keywords": [
    "paypal",
    "disputes",
    "telemetry",
    "chargeback",
    "sdk"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run clean && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}